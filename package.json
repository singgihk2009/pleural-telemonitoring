{
  "name": "pleural-telemonitoring",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @pleural/mobile start",
    "dev:dashboard": "pnpm --filter @pleural/dashboard dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter @pleural/dashboard build",
    "build:mobile": "pnpm --filter @pleural/mobile build",
    "dev:up": "docker compose up -d --build --wait",
    "dev:down": "docker compose down",
    "validate:openapi": "redocly lint docs/api/openapi.yaml --config redocly.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^2.72.0"
  }
}
