# EAS reads this at the Git root and replaces all nested .gitignore files.
node_modules/
.expo/
dist/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example
!**/.env.example
.DS_Store
*.log
.pnpm-store/
.git/
.github/
/apps/api/
/apps/dashboard/
/docs/
/infra/
**/vendor/
# Signing material stays in the approved EAS credential store, never the archive.
credentials.json
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.apk
*.aab
# Native folders are generated by Expo CNG, not uploaded from local experiments.
/apps/mobile/android/
/apps/mobile/ios/
.kotlin/
*.orig.*
web-build/
expo-env.d.ts
.metro-health-check*
# Test-only fixtures and harnesses are not build inputs.
**/*.test.ts
**/*.test.tsx
**/jest.setup.ts
.aws/
.ssh/
.codex/
.agents/
*.pfx
